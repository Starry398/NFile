+
+String _apkInstallerLabel(String value) {
+  if (value.isEmpty) return '每次询问（系统选择器）';
+  if (value == 'shizuku') return 'Shizuku 静默安装';
+  return value;
+}
+
+Future<void> _showApkInstallerSheet(
+  BuildContext context,
+  FileManagerProvider fm,
+) async {
+  final theme = Theme.of(context);
+  const channel = MethodChannel('com.rubex.nfile/install_apk');
+  List<Map<String, String>> installers = [];
+  try {
+    final raw = await channel.invokeMethod('list');
+    if (raw is List) {
+      installers = raw
+          .map((e) => Map<String, String>.from(e as Map))
+          .toList();
+    }
+  } catch (_) {}
+  if (!context.mounted) return;
+
+  await showModalBottomSheet(
+    context: context,
+    isScrollControlled: true,
+    backgroundColor: theme.scaffoldBackgroundColor,
+    shape: const RoundedRectangleBorder(
+      borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
+    ),
+    builder: (ctx) {
+      final current = fm.apkInstaller;
+
+      Widget option({
+        required String value,
+        required String label,
+        required String desc,
+        bool disabled = false,
+      }) {
+        final selected = current == value;
+        return InkWell(
+          borderRadius: BorderRadius.circular(14),
+          onTap: disabled
+              ? null
