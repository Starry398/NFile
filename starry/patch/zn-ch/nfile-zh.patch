new file mode 100644
index 0000000..a929227
--- /dev/null
+++ b/tools/i18n/README.md
@@ -0,0 +1,38 @@
+# NFile 汉化机制
+
+源码里文案全是硬编码英文字符串，没有 ARB / l10n。为了能跟上上游更新，
+本仓库不改结构，只用「词库 + 注入脚本」在构建前把英文替换成中文。
+
+```
+tools/i18n/
+  src/*.tsv      # 人工维护的分批词库（英文<TAB>中文，一行一条）
+  zh.json        # merge.py 生成的最终词库
+  merge.py       # tsv -> zh.json
+  extract.py     # 扫描 lib/ 导出候选英文字符串（维护用）
+  apply_zh.py    # 把 zh.json 注入 lib/**/*.dart（幂等）
+```
+
+## 日常工作流
+
+```bash
+python3 tools/i18n/merge.py          # 合并 tsv
+python3 tools/i18n/apply_zh.py --dry-run --missing   # 预演，看命中率
+python3 tools/i18n/apply_zh.py       # 真正写入
+```
+
+上游更新后重新拉代码会带回英文，再跑一次 `apply_zh.py` 即可恢复中文。
+
+## 约定
+
+- 专有名词保留英文：FTP / SFTP / SMB / WEBDAV / RAW / SAF / APK / PDF 等。
+- 插值变量（`$name`、`${expr}`）必须原样保留，否则运行时报错。
+- 含 `"` 的中文会被跳过（脚本保守处理），这种条目请改写措辞。
+- 只替换「整段字符串完全等于词库 key」的字面量，不会误伤路径、prefs key、日志。
+
+## 已做的代码级改动（词库覆盖不到的）
+
+- `pubspec.yaml`：加 `flutter_localizations`
+- `lib/main.dart`：`locale: zh_CN`、`supportedLocales`、`localizationsDelegates`、`Intl.defaultLocale`
+- `lib/core/utils.dart`：日期格式改 `yyyy年M月d日`
+- `android/app/src/main/AndroidManifest.xml`：`android:label="NFile 汉化版"`
+- `android/app/build.gradle.kts`：`applicationId = com.rubex.nfile.starry`、localeFilters 加 zh、无 keystore 时回落 debug 签名
diff --git a/tools/i18n/apply_zh.py b/tools/i18n/apply_zh.py
new file mode 100644
index 0000000..4079f80
--- /dev/null
+++ b/tools/i18n/apply_zh.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""NFile 汉化注入器 — 把 zh.json 里的英文文案替换成中文。
+幂等：英文原文被替换后不会二次替换；上游更新重新拉回英文时再次运行即可。
+用法: python3 tools/i18n/apply_zh.py [--dry-run] [--missing]
+"""
+import json, os, re, sys, io
+
+ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..')
+LIB = os.path.join(ROOT, 'lib')
+DICT_PATH = os.path.join(ROOT, 'tools', 'i18n', 'zh.json')
+
+SKIP_LINE = re.compile(r'debugPrint\(|(?<![\w.])print\(|^\s*import |^\s*export |^\s*//')
+LIT = re.compile(r"'((?:[^'\\\n]|\\.)*)'|\"((?:[^\"\\\n]|\\.)*)\"")
+
+
+def load_dict():
+    with open(DICT_PATH, encoding='utf-8') as f:
+        return json.load(f)
+
+
+def main():
+    dry = '--dry-run' in sys.argv
+    show_missing = '--missing' in sys.argv
+    norm = lambda s: s.replace("\\'", "'").replace('\\"', '"')
+    table = {norm(k): v for k, v in load_dict().items()}
+    used = set()
+    changed_files = 0
+    changed_lits = 0
+    for root, _, files in os.walk(LIB):
+        for name in sorted(files):
+            if not name.endswith('.dart'):
+                continue
+            path = os.path.join(root, name)
+            with open(path, encoding='utf-8') as f:
+                lines = f.readlines()
+            out = []
+            file_changed = False
+            for line in lines:
+                if SKIP_LINE.search(line):
+                    out.append(line)
+                    continue
+
+                def repl(m):
+                    nonlocal changed_lits, file_changed
+                    raw = m.group(0)
+                    inner = m.group(1) if m.group(1) is not None else m.group(2)
+                    if norm(inner) not in table:
+                        return raw
+                    used.add(norm(inner))
+                    zh = table[norm(inner)]
+                    q = raw[0]
+                    if q in zh:
+                        return raw  # 中文里含引号，保守跳过
+                    changed_lits += 1
+                    file_changed = True
+                    return q + zh + q
+
+                out.append(LIT.sub(repl, line))
+            if file_changed:
+                changed_files += 1
+                if not dry:
+                    with open(path, 'w', encoding='utf-8') as f:
+                        f.writelines(out)
+    print(f'{"[dry-run] " if dry else ""}替换 {changed_lits} 处 / 文件 {changed_files} 个 / 词库 {len(table)} 条')
+    if show_missing:
+        miss = [k for k in table if k not in used]
+        print(f'词库中未被用到的条目 {len(miss)} 条')
+        for k in miss[:40]:
+            print('  MISS:', k)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/i18n/extract.py b/tools/i18n/extract.py
new file mode 100644
index 0000000..f7d61d3
--- /dev/null
+++ b/tools/i18n/extract.py
@@ -0,0 +1,25 @@
+import re, os, json, sys
+ROOT = sys.argv[1] if len(sys.argv)>1 else 'lib'
+LIT = re.compile(r"'((?:[^'\\\n]|\\.)*)'|\"((?:[^\"\\\n]|\\.)*)\"")
+SKIP_LINE = re.compile(r'debugPrint\(|print\(|assert\(|^\s*import |^\s*export ')
+def ok(t):
+    if len(t) < 2 or len(t) > 220: return False
+    if not re.search(r'[A-Za-z]{2}', t): return False
+    if not (' ' in t or len(t) > 3): return False
+    if t.startswith(('package:','dart:','http','content:','file:','assets/','mipmap','android.','com.','\$')): return False
+    if re.fullmatch(r'[a-z0-9_./:%${}<>=\-]+', t): return False
+    if re.search(r'/(data|storage|sdcard)/', t): return False
+    if t.strip() in ('true','false','null'): return False
+    return True
+out = {}
+for root,_,fs in os.walk(ROOT):
+    for f in sorted(fs):
+        if not f.endswith('.dart'): continue
+        p = os.path.join(root,f)
+        for i,line in enumerate(open(p,encoding='utf-8',errors='ignore'),1):
+            if SKIP_LINE.search(line): continue
+            for m in LIT.finditer(line):
+                t = m.group(1) if m.group(1) is not None else m.group(2)
+                if ok(t) and t not in out:
+                    out[t] = [p, i]
+print(json.dumps(out, ensure_ascii=False, indent=0))
diff --git a/tools/i18n/merge.py b/tools/i18n/merge.py
new file mode 100644
index 0000000..337b5ad
--- /dev/null
+++ b/tools/i18n/merge.py
@@ -0,0 +1,13 @@
+import json, glob, os
+d = {}
+for f in sorted(glob.glob('tools/i18n/src/*.tsv')):
+    for ln, line in enumerate(open(f, encoding='utf-8'), 1):
+        line = line.rstrip('\n')
+        if not line.strip() or line.startswith('#'): continue
+        if '\t' not in line:
+            print('BAD LINE', f, ln, line); continue
+        k, v = line.split('\t', 1)
+        if k in d and d[k] != v: print('DUP', k)
+        d[k] = v
+json.dump(d, open('tools/i18n/zh.json','w',encoding='utf-8'), ensure_ascii=False, indent=1, sort_keys=True)
+print('entries', len(d))
