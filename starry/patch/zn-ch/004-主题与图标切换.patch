diff --git a/lib/services/update_service.dart b/lib/services/update_service.dart
new file mode 100644
index 0000000..09f21f2
--- /dev/null
+++ b/lib/services/update_service.dart
@@ -0,0 +1,109 @@
+import 'dart:convert';
+import 'dart:io';
+
+/// 一条 release 信息
+class UpdateInfo {
+  final String tag;
+  final String apkUrl;
+  final String pageUrl;
+  final bool isPre;
+
+  UpdateInfo({
+    required this.tag,
+    required this.apkUrl,
+    required this.pageUrl,
+    required this.isPre,
+  });
+}
+
+/// 检查 Starry398/NFile 的更新。
+///
+/// 规则和 FlClash / Bettbox 的 fork 一致：
+/// - 正式版只认不带 `-pre.` 的 tag，不会提示 pre 版
+/// - pre 版只认带 `-pre.` 的 tag，也不会提示正式版
+class UpdateService {
+  static const String owner = 'Starry398';
+  static const String repo = 'NFile';
+
+  /// 当前版本号，随上游 tag 更新时同步修改
+  static const String currentVersion = '1.0.44';
+
+  static Future<List<UpdateInfo>> _fetchReleases() async {
+    final client = HttpClient();
+    try {
+      final req = await client.getUrl(
+        Uri.parse('https://api.github.com/repos/$owner/$repo/releases?per_page=30'),
+      );
+      req.headers.set('Accept', 'application/vnd.github+json');
+      req.headers.set('User-Agent', 'NFile-Starry');
+      final res = await req.close().timeout(const Duration(seconds: 15));
+      final body = await res.transform(utf8.decoder).join();
+      if (res.statusCode != 200) return const [];
+
+      final list = jsonDecode(body) as List;
+      final result = <UpdateInfo>[];
+      for (final raw in list) {
+        final map = raw as Map<String, dynamic>;
+        final tag = (map['tag_name'] ?? '') as String;
+        if (tag.isEmpty) continue;
+
+        String apkUrl = '';
+        final assets = (map['assets'] as List?) ?? const [];
+        for (final a in assets) {
+          final m = a as Map<String, dynamic>;
+          final name = (m['name'] ?? '') as String;
+          if (name.endsWith('.apk')) {
+            apkUrl = (m['browser_download_url'] ?? '') as String;
+            break;
+          }
+        }
+
+        result.add(
+          UpdateInfo(
+            tag: tag,
+            apkUrl: apkUrl,
+            pageUrl: 'https://github.com/$owner/$repo/releases/tag/$tag',
+            isPre: tag.contains('-pre.'),
+          ),
+        );
+      }
+      return result;
+    } catch (_) {
+      return const [];
+    } finally {
+      client.close(force: true);
+    }
+  }
+
+  /// 返回比当前版本新的 release，没有则 null
+  static Future<UpdateInfo?> checkUpdate({required bool isPre}) async {
+    final all = await _fetchReleases();
+    for (final r in all) {
+      if (r.isPre != isPre) continue;
+      if (_isNewer(r.tag)) return r;
+    }
+    return null;
+  }
+
+  static bool _isNewer(String tag) {
+    final a = _parse(tag);
+    final b = _parse('v$currentVersion');
+    if (a == null || b == null) return false;
+    if (a.$1 != b.$1) return a.$1 > b.$1;
+    if (a.$2 != b.$2) return a.$2 > b.$2;
+    if (a.$3 != b.$3) return a.$3 > b.$3;
+    return a.$4 > b.$4;
+  }
+
+  /// (major, minor, patch, preNumber)
+  static (int, int, int, int)? _parse(String tag) {
+    final m = RegExp(r'v?(\d+)\.(\d+)\.(\d+)(?:-pre\.(\d+))?').firstMatch(tag);
+    if (m == null) return null;
+    return (
+      int.parse(m.group(1)!),
+      int.parse(m.group(2)!),
+      int.parse(m.group(3)!),
+      int.parse(m.group(4) ?? '0'),
+    );
+  }
+}
