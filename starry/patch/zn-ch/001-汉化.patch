new file mode 100644
index 0000000..f7d61d3
--- /dev/null
+++ b/tools/i18n/extract.py
@@ -0,0 +1,25 @@
+import re, os, json, sys
+ROOT = sys.argv[1] if len(sys.argv)>1 else 'lib'
+LIT = re.compile(r"'((?:[^'\\\n]|\\.)*)'|\"((?:[^\"\\\n]|\\.)*)\"")
+SKIP_LINE = re.compile(r'debugPrint\(|print\(|assert\(|^\s*import |^\s*export ')
+def ok(t):
+    if len(t) < 2 or len(t) > 220: return False
+    if not re.search(r'[A-Za-z]{2}', t): return False
+    if not (' ' in t or len(t) > 3): return False
+    if t.startswith(('package:','dart:','http','content:','file:','assets/','mipmap','android.','com.','\$')): return False
+    if re.fullmatch(r'[a-z0-9_./:%${}<>=\-]+', t): return False
+    if re.search(r'/(data|storage|sdcard)/', t): return False
+    if t.strip() in ('true','false','null'): return False
+    return True
+out = {}
+for root,_,fs in os.walk(ROOT):
+    for f in sorted(fs):
+        if not f.endswith('.dart'): continue
+        p = os.path.join(root,f)
+        for i,line in enumerate(open(p,encoding='utf-8',errors='ignore'),1):
+            if SKIP_LINE.search(line): continue
+            for m in LIT.finditer(line):
+                t = m.group(1) if m.group(1) is not None else m.group(2)
+                if ok(t) and t not in out:
+                    out[t] = [p, i]
+print(json.dumps(out, ensure_ascii=False, indent=0))
diff --git a/tools/i18n/merge.py b/tools/i18n/merge.py
new file mode 100644
index 0000000..337b5ad
--- /dev/null
+++ b/tools/i18n/merge.py
@@ -0,0 +1,13 @@
+import json, glob, os
+d = {}
+for f in sorted(glob.glob('tools/i18n/src/*.tsv')):
+    for ln, line in enumerate(open(f, encoding='utf-8'), 1):
+        line = line.rstrip('\n')
+        if not line.strip() or line.startswith('#'): continue
+        if '\t' not in line:
+            print('BAD LINE', f, ln, line); continue
+        k, v = line.split('\t', 1)
+        if k in d and d[k] != v: print('DUP', k)
+        d[k] = v
+json.dump(d, open('tools/i18n/zh.json','w',encoding='utf-8'), ensure_ascii=False, indent=1, sort_keys=True)
+print('entries', len(d))
