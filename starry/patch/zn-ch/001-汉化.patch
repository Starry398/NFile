+#!/usr/bin/env python3
+"""修补 on_audio_query 的 "Reply already submitted" 崩溃。
+
+问题：on_audio_query 的 AudioQuery 等类把 `result.success(...)` 放在协程里，
+而 PluginProvider 的 result 是共享的。当 Dart 侧并发调用两次查询时，第二次
+调用会覆盖共享的 result，两个协程先后 reply 同一个 result，
+Flutter 的 MethodChannel 抛 IllegalStateException("Reply already submitted")，
+属于 Java 层异常，直接杀死进程（表现为启动闪退）。
+
+处理：把所有 queries/*.kt 里的顶层 `result.success(...)` 包一层 try/catch，
+重复 reply 时只记录日志，不再崩溃。
+
+幂等：已修补过的文件不会再改。
+
+用法：python3 tools/patch_oaq.py [pub_cache_root]
+默认扫描 $HOME/.pub-cache/git/**/on_audio_query_android/**/queries/*.kt
+"""
+import os
+import re
+import sys
+
+ROOT = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser('~/.pub-cache')
+LINE = re.compile(r'^(?P<indent>[ \t]*)result\.success\((?P<expr>.*)\)\s*$')
+
+
+def patch_file(path: str) -> int:
+    with open(path, encoding='utf-8') as f:
+        lines = f.readlines()
+    out, hits = [], 0
+    for line in lines:
+        if 'reply skipped' in line:
+            out.append(line)          # 已修补
+            continue
+        m = LINE.match(line.rstrip('\n'))
+        if not m:
+            out.append(line)
+            continue
+        indent, expr = m.group('indent'), m.group('expr')
+        out.append(
+            f'{indent}try {{ result.success({expr}) }} '
+            f'catch (e: Exception) {{ android.util.Log.w("OnAudioQuery", '
+            f'"duplicate reply skipped: " + e.message) }}\n'
+        )
+        hits += 1
+    if hits:
+        with open(path, 'w', encoding='utf-8') as f:
+            f.writelines(out)
+    return hits
+
+
+def main() -> None:
+    total_files = total_hits = 0
+    for dirpath, dirnames, filenames in os.walk(ROOT):
+        if 'on_audio_query_android' not in dirpath:
+            continue
+        if os.path.basename(dirpath) != 'queries':
+            continue
+        for name in filenames:
+            if not name.endswith('.kt'):
+                continue
+            hits = patch_file(os.path.join(dirpath, name))
+            if hits:
+                total_files += 1
+                total_hits += hits
+                print(f'patched {name}: {hits}')
+    print(f'on_audio_query: {total_hits} call sites in {total_files} files patched')
+    if total_files == 0:
+        print('::warning::on_audio_query sources not found, skipped')
+
+
+if __name__ == '__main__':
+    main()
