+  /// 通过 Shizuku 执行 pm install，成功返回 true。
+  static Future<bool> _installViaShizuku(BuildContext context, String path) async {
+    try {
+      final granted = await RootShizukuService.requestShizukuPermission();
+      if (!granted) {
+        if (context.mounted) {
+          ScaffoldMessenger.of(context).showSnackBar(
+            const SnackBar(
+              content: Text('Shizuku 未授权，已改用系统安装器'),
+              behavior: SnackBarBehavior.floating,
+            ),
+          );
+        }
+        return false;
+      }
+
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(
+            content: Text('正在通过 Shizuku 安装 ${p.basename(path)}…'),
+            behavior: SnackBarBehavior.floating,
+            duration: const Duration(seconds: 2),
+          ),
+        );
+      }
+
+      final safePath = path.replaceAll('"', '\\"');
+      final output = await RootShizukuService.runCommand(
+        'pm install -r -t "$safePath"',
+        useRoot: false,
+      );
+
+      final ok = (output ?? '').contains('Success');
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(
+            content: Text(ok ? '安装成功' : '安装失败：${output ?? '无输出'}'),
+            behavior: SnackBarBehavior.floating,
+            duration: Duration(seconds: ok ? 2 : 5),
+          ),
+        );
+      }
+      return ok;
+    } catch (e) {
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text('Shizuku 安装出错：$e'), behavior: SnackBarBehavior.floating),
+        );
+      }
+      return false;
+    }
+  }
