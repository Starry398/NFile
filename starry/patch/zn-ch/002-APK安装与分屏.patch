+        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "com.rubex.nfile/install_apk").setMethodCallHandler { call, result ->
+            when (call.method) {
+                "list" -> {
+                    try {
+                        val probe = Intent(Intent.ACTION_VIEW).apply {
+                            setDataAndType(Uri.parse("file:///tmp/_probe.apk"), "application/vnd.android.package-archive")
+                        }
+                        val infos = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                            packageManager.queryIntentActivities(probe, PackageManager.ResolveInfoFlags.of(0))
+                        } else {
+                            @Suppress("DEPRECATION")
+                            packageManager.queryIntentActivities(probe, 0)
+                        }
+                        val seen = mutableSetOf<String>()
+                        val out = mutableListOf<Map<String, String>>()
+                        for (ri in infos) {
+                            val pkg = ri.activityInfo.packageName
+                            if (!seen.add(pkg)) continue
+                            val label = try { ri.loadLabel(packageManager).toString() } catch (e: Exception) { pkg }
+                            out.add(mapOf("package" to pkg, "label" to label))
+                        }
+                        result.success(out)
+                    } catch (e: Exception) {
+                        result.error("ERROR", e.message, null)
+                    }
+                }
+                "install" -> {
+                    val path = call.argument<String>("path")
+                    val targetPackage = call.argument<String>("targetPackage")
+                    if (path.isNullOrEmpty()) {
+                        result.error("ARGS", "path is null", null)
+                        return@setMethodCallHandler
+                    }
+                    val file = File(path)
+                    if (!file.exists()) {
+                        result.error("NOT_FOUND", "apk not found: $path", null)
+                        return@setMethodCallHandler
+                    }
+                    try {
+                        val uri = androidx.core.content.FileProvider.getUriForFile(
+                            this,
+                            "$packageName.apkinstaller",
+                            file
+                        )
+                        val baseIntent = Intent(Intent.ACTION_VIEW).apply {
+                            setDataAndType(uri, "application/vnd.android.package-archive")
+                            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                            clipData = android.content.ClipData.newRawUri(null, uri)
+                        }
+                        runOnUiThread {
+                            try {
+                                if (!targetPackage.isNullOrEmpty()) {
+                                    val target = Intent(baseIntent).apply { setPackage(targetPackage) }
+                                    if (packageManager.resolveActivity(target, 0) != null) {
+                                        startActivity(target)
+                                        result.success(true)
+                                        return@runOnUiThread
+                                    }
+                                }
+                                startActivity(Intent.createChooser(baseIntent, "选择安装器"))
+                                result.success(true)
+                            } catch (e: Exception) {
+                                result.error("NO_HANDLER", e.message, null)
+                            }
+                        }
+                    } catch (e: Exception) {
+                        result.error("ERROR", e.message, null)
+                    }
+                }
+                else -> result.notImplemented()
+            }
+        }
